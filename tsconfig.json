{
	"compilerOptions": {
		"allowJs": false,

		"strict": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,

		"module": "ESNext",
		"target": "es6",
		"moduleResolution": "bundler",

		"esModuleInterop": true,
		"isolatedModules": true,

		"sourceMap": true,
		"inlineSources": true,
		"noEmit": true,

		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*.ts"
	]
}